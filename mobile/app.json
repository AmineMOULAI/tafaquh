{
  "expo": {
    "name": "Izkur (اذْكُرْ)",
    "slug": "izkur-tafaqquh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0D0B"
    },
    "android": {
      "package": "com.tafaqquh.izkur",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3B2C"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow Izkur to record audio for hands-free voice Dhikr counting."
        }
      ]
    ]
  }
}
